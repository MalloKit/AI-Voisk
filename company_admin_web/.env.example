# Public browser settings only. Never put DB credentials or API secrets here.
VITE_ORDER_API_BASE_URL=http://127.0.0.1:8001
# api (default) or mock (explicit demo mode; never an error fallback)
VITE_ORDER_SOURCE=api

# Store reads use the admin endpoint; no automatic Mock fallback.
VITE_STORE_API_BASE_URL=http://127.0.0.1:8001
VITE_STORE_SOURCE=api

# Owner reads are independent of store Mock mode; never an error fallback.
VITE_OWNER_API_BASE_URL=http://127.0.0.1:8001
VITE_OWNER_SOURCE=api

# 공개 API 주소만 설정합니다. 대시보드도 같은 기기·알림 조회를 공유합니다.
VITE_DEVICE_API_BASE_URL=http://127.0.0.1:8001
VITE_DEVICE_SOURCE=api

# 알림 조회는 기본 api이며 Mock 확인 처리는 mock 시연에만 적용합니다.
VITE_ALERT_API_BASE_URL=http://127.0.0.1:8001
VITE_ALERT_SOURCE=api


# 관리자 인증 서버 공개 주소. 생략하면 주문 API 주소를 사용합니다.
# 모든 Mock 데이터 출처도 서버 인증을 거쳐야 합니다. 비밀번호·토큰은 넣지 마세요.
VITE_ADMIN_AUTH_API_BASE_URL=http://127.0.0.1:8001
