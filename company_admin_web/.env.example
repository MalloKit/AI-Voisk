# Public browser settings only. Never put DB credentials or API secrets here.
VITE_ORDER_API_BASE_URL=http://127.0.0.1:8001
# api (default) or mock (explicit demo mode; never an error fallback)
VITE_ORDER_SOURCE=api

# Store reads use the admin endpoint; no automatic Mock fallback.
VITE_STORE_API_BASE_URL=http://127.0.0.1:8001
VITE_STORE_SOURCE=api
